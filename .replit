modules = ["nodejs-20", "web", "php-8.2", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start AFK Bot"

[[workflows.workflow]]
name = "Start AFK Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'export PORT=3001 DATA_DIR=$HOME/afkbot-data STATIC_DIR=$(pwd)/artifacts/frontend/public && mkdir -p $DATA_DIR && pkill -f dist/index.mjs 2>/dev/null; sleep 1 && (cd artifacts/api-server && pnpm run start) &  sleep 6 && cd artifacts/frontend && php -S 0.0.0.0:8080 -t public'"
waitForPort = 8080

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18130
externalPort = 3000

[nix]
channel = "stable-25_05"
